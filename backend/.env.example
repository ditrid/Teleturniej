# Skopiuj ten plik jako .env i uzupełnij wartości.

# Połączenie z PostgreSQL (użyj docker-compose.yml aby uruchomić lokalnie)
DATABASE_URL="postgresql://kwakout:kwakout@localhost:5432/kwakout?schema=public"

# Sekret do podpisywania JWT (wygeneruj np.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="zmien-mnie-na-losowy-sekret"

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Adres zwrotny OAuth — musi być dodany w Google Console jako "Authorized redirect URI".
# Dev (przez proxy Vite): http://localhost:5173/auth/google/callback
# Produkcja (backend na Renderze): https://teleturniej-vbd5.onrender.com/auth/google/callback
AUTH_CALLBACK_URL="http://localhost:5173/auth/google/callback"

# Gdzie frontend jest dostępny (na ten adres wracamy po zalogowaniu).
# Produkcja: adres frontendu na Renderze, np. https://twoj-frontend.onrender.com
FRONTEND_URL="http://localhost:5173"

# CORS — lista dozwolonych originów frontendu oddzielona przecinkiem.
# Jeżeli nie ustawione, backend pozwala na wszystko (tryb permissive).
# Produkcja: ustaw na adres frontendu Render (może być kilka, oddzielonych przecinkiem).
# CORS_ORIGINS="https://twoj-frontend.onrender.com"

# Port serwera (domyślnie 5000)
PORT=5000
